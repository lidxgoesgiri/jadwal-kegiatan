# Referensi nama environment variable, BUKAN file yang otomatis dibaca PHP.
# Pada XAMPP: salin config/local.example.php menjadi config/local.php.
# Pada Azure: isi Settings > Environment variables. Jangan unggah password.
APP_ENV=production
DB_HOST=namaserver.mysql.database.azure.com
DB_PORT=3306
DB_DATABASE=jadwal_kegiatan
DB_USERNAME=jadwal_app
DB_PASSWORD=
DB_SSL_CA=/home/site/wwwroot/certs/azure-mysql-ca.pem
